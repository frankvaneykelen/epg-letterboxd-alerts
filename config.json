{
  "ziggo": {
    "enabled": true,
    "channel_file": "data/channels.txt",
    "xmltv_file": "data/ziggogo.xml",
    "database_file": "data/ziggogoepg_cache.sqlite3",
    "scan_days": 14,
    "configuration": "ziggo-nl"
  },
  "tmdb": {
    "base_url": "https://api.themoviedb.org/3"
  },
  "letterboxd": {
    "enabled": true,
    "auto_import": false,
    "watchlist_csv": "data/watchlist.csv",
    "watched_csv": "data/watched.csv",
    "diary_csv": "data/diary.csv",
    "do_not_watchlist_csv": "data/do-not-watchlist.csv"
  },
  "filters": {
    "languages": ["en", "nl"],
    "min_rating": 6.5,
    "include_subtitles": true
  },
  "notifications": {
    "enabled": false,
    "service": "azure-notification-hubs"
  }
}
